{
  "name": "deploybot",
  "version": "1.0.0",
  "description": "",
  "homepage": "https://github.com/KletskovG/deploybot#readme",
  "bugs": {
    "url": "https://github.com/KletskovG/deploybot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KletskovG/deploybot.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "husky",
    "build": "npm run copy:env && vite build && npm run copy:env:dist",
    "dev": "npm run build && node dist/index.js",
    "start": "node dist/index.js",
    "copy:env:dist": "cp .config/env/.env.development dist/.env 2>/dev/null || echo 'Warning: .env file not found, skipping copy'",
    "copy:env": "cp .config/env/.env.production ./.env 2>/dev/null || echo 'Warning: .env file not found, skipping copy'",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "reb": "git rebase origin/main"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "dotenv": "16.4.1",
    "fastify": "4.26.0",
    "grammy": "1.21.1",
    "husky": "9.1.7",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "25.2.0",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "8.57.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "vite": "6.1.0",
    "vite-node": "3.0.4"
  }
}
