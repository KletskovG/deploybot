{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    "types": ["node"],
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["./src/server/*"],
      "@bot/*": ["./src/bot/*"],
      "@config/*": ["./src/config/*"],
      "@logger/*": ["./src/logger/*"],
      "@typings/*": ["./src/typings/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}