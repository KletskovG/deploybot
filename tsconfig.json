{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    "types": ["node"],
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@server/*": ["./src/server/*"],
      "@server": ["./src/server"],
      "@bot/*": ["./src/bot/*"],
      "@bot": ["./src/bot"],
      "@config/*": ["./src/config/*"],
      "@config": ["./src/config"],
      "@logger/*": ["./src/logger/*"],
      "@logger": ["./src/logger"],
      "@typings/*": ["./src/typings/*"],
      "@typings": ["./src/typings"],
      "@db/*": ["./src/db/*"],
      "@db": ["./src/db"],
      "@lib/*": ["./src/lib/*"],
      "@lib": ["./src/lib"],
      "@core/*": ["./src/core/*"],
      "@core": ["./src/core"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}